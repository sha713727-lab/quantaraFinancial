{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src instrumentation.ts next.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/env.test.ts src/constants/allowed-origins.test.ts src/schemas/contact-enquiry.test.ts src/server/database/token-bucket.test.ts src/features/landing/presence-globe-geometry.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "npm audit --audit-level=high",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "eslint --max-warnings=0",
      "prettier --check"
    ]
  },
  "dependencies": {
    "gsap": "3.15.0",
    "lucide-react": "1.31.0",
    "next": "16.3.0",
    "nodemailer": "9.0.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "20.19.11",
    "@types/nodemailer": "8.0.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "eslint": "9.34.0",
    "eslint-config-next": "16.3.0",
    "husky": "9.1.7",
    "lint-staged": "16.1.5",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.1.13",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
